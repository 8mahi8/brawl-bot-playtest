{
  "rules": {
    ".read": false,
    ".write": false,
    "draftStagingRooms": {
      "$roomId": {
        "public": {
          ".read": "auth !== null && data.parent().child('members').child(auth.uid).child('state').val() === 'active'"
        },
        "members": {
          "$uid": {
            ".read": "auth !== null && auth.uid === $uid && root.child('draftStagingRooms/' + $roomId + '/members/' + $uid + '/state').val() === 'active'"
          }
        },
        "sessions": {
          "$uid": {
            ".read": "auth !== null && auth.uid === $uid && root.child('draftStagingRooms/' + $roomId + '/members/' + $uid + '/state').val() === 'active'"
          }
        },
        "views": {
          "$uid": {
            ".read": "auth !== null && auth.uid === $uid && root.child('draftStagingRooms/' + $roomId + '/members/' + $uid + '/state').val() === 'active'"
          }
        },
        "receipts": {
          "$uid": {
            ".read": "auth !== null && auth.uid === $uid && root.child('draftStagingRooms/' + $roomId + '/members/' + $uid + '/state').val() === 'active'"
          }
        },
        "inputs": {
          "$uid": {
            "$actionId": {
              ".write": "auth !== null && auth.uid === $uid && root.child('draftStagingRooms/' + $roomId + '/members/' + $uid + '/state').val() === 'active' && root.child('draftStagingRooms/' + $roomId + '/sessions/' + $uid + '/expiresAt').val() > now && root.child('draftStagingRooms/' + $roomId + '/sessions/' + $uid + '/connectionId').val() === newData.child('connectionId').val() && !data.exists() && newData.exists() && $actionId.matches(/^[A-Za-z0-9_-]{8,80}$/) && newData.child('at').val() >= now - 5000 && newData.child('at').val() <= now + 1000 && newData.child('seq').val() > root.child('draftStagingRooms/' + $roomId + '/acceptedSeq/' + $uid).val() && root.child('draftStagingRooms/' + $roomId + '/server/phase').val() === 'playing' && root.child('draftStagingRooms/' + $roomId + '/server/matchId').val() === newData.child('matchId').val() && root.child('draftStagingRooms/' + $roomId + '/server/round').val() === newData.child('round').val() && root.child('draftStagingRooms/' + $roomId + '/server/lives/' + $uid).val() === newData.child('life').val() && root.child('draftStagingRooms/' + $roomId + '/server/hp/' + $uid).val() > 0 && newData.child('seq').val() <= root.child('draftStagingRooms/' + $roomId + '/acceptedSeq/' + $uid).val() + 32",
              ".validate": "newData.hasChildren(['type','seq','matchId','round','life','connectionId','at','x','y','angle','reach']) && (newData.child('type').val() !== 'move' || (newData.hasChildren(['dx','dy']) && newData.child('dx').isNumber() && newData.child('dy').isNumber()))",
              "type": {
                ".validate": "newData.isString() && (newData.val() === 'move' || newData.val() === 'shot' || newData.val() === 'gadget' || newData.val() === 'gadget2' || newData.val() === 'ultimate')"
              },
              "seq": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000 && newData.val() % 1 === 0"
              },
              "matchId": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{8,80}$/)"
              },
              "round": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 === 0"
              },
              "life": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0"
              },
              "connectionId": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{8,80}$/)"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 18 && newData.val() <= 1902"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 18 && newData.val() <= 1042"
              },
              "angle": {
                ".validate": "newData.isNumber() && newData.val() >= -6.28319 && newData.val() <= 6.28319"
              },
              "reach": {
                ".validate": "newData.isNumber() && newData.val() >= 55 && newData.val() <= 330"
              },
              "$other": {
                ".validate": false
              },
              "dx": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
              },
              "dy": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
              }
            }
          }
        },
        "positions": {},
        "presence": {
          "$uid": {
            "$connectionId": {
              ".write": "auth !== null && auth.uid === $uid && root.child('draftStagingRooms/' + $roomId + '/members/' + $uid + '/state').val() === 'active' && root.child('draftStagingRooms/' + $roomId + '/sessions/' + $uid + '/expiresAt').val() > now && root.child('draftStagingRooms/' + $roomId + '/sessions/' + $uid + '/connectionId').val() === $connectionId",
              ".validate": "newData.hasChildren(['since'])",
              "since": {
                ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now + 1000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
