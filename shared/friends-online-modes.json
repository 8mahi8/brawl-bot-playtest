{
  "schemaVersion": 1,
  "purpose": "Four standalone friend-playtest variants. Build candidate outputs without touching frozen published HTML or Google Sites.",
  "modules": {
    "squadEarlyShots": "shared/runtime/friends-2v2-early-shots.inc.js"
  },
  "modes": {
    "normal.1vs1": {
      "source": "sites/BRAWL_FRIENDS_1vs1_QA_CANDIDATE.html",
      "output": "artifacts/friends-online/normal-1vs1.html",
      "roomRoot": "rooms",
      "protocol": 31,
      "modules": []
    },
    "normal.2vs2": {
      "source": "sites/BRAWL_FRIENDS_2vs2_LATENCY_CANDIDATE.html",
      "output": "artifacts/friends-online/normal-2vs2.html",
      "roomRoot": "rooms2v2",
      "protocol": 3012,
      "modules": [
        "squadEarlyShots"
      ]
    },
    "draft.1vs1": {
      "source": "sites/BRAWL_DRAFT_FRIENDS_BETA_1vs1.html",
      "output": "artifacts/friends-online/draft-1vs1.html",
      "roomRoot": "rooms",
      "protocol": 1031,
      "modules": []
    },
    "draft.2vs2": {
      "source": "sites/BRAWL_DRAFT_FRIENDS_BETA_2vs2_LATENCY_CANDIDATE.html",
      "output": "artifacts/friends-online/draft-2vs2.html",
      "roomRoot": "rooms2v2",
      "protocol": 13012,
      "modules": [
        "squadEarlyShots"
      ]
    }
  },
  "forbiddenWritePrefixes": [
    "sites/BRAWL_FRIENDS_1vs1.html",
    "sites/BRAWL_FRIENDS_2vs2.html",
    "sites/BRAWL_DRAFT_FRIENDS_BETA_1vs1.html",
    "sites/BRAWL_DRAFT_FRIENDS_BETA_2vs2.html"
  ]
}
